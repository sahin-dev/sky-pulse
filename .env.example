# Where flight data comes from: free | aviationstack | demo
#   free (default without a key): ADS-B positions + open callsign→route database — no paid service.
#   aviationstack (default with a key): schedules, gates, delays from aviationstack, enriched with ADS-B.
#   demo: simulated flights.
FLIGHT_DATA=

# Optional aviationstack API key (from apilayer.com / your aviationstack dashboard).
# Leave empty to run entirely on free data.
AVIATIONSTACK_API_KEY=

# APILayer gateway for aviationstack (HTTPS).
AVIATIONSTACK_BASE_URL=https://api.apilayer.net/aviationstack/v1

# --- Live radar: loading flights for the visible map area ---
# aviationstack can't filter by coordinates, so the radar combines:
#  * a cached global snapshot of airborne flights (pages x limit, refreshed every ~10 min), filtered to the viewport
#  * live departures from the busiest airports in view once the user zooms into a region (1 request per airport, cached 10 min)
# Results per request: 100 below the Professional plan, up to 1000 on Professional and above.
AVIATIONSTACK_PAGE_LIMIT=100
# Pages in the global snapshot (each page = 1 request per cache refresh).
AVIATIONSTACK_SNAPSHOT_PAGES=1
# Hub airports queried per zoomed-in area (0 = off, saves quota).
AVIATIONSTACK_REGION_AIRPORTS=2

# --- Live aircraft positions (ADS-B) — free, no aviationstack quota ---
# auto (default): zoomed-in views use adsb.lol (no key), wider views use OpenSky; each falls back to the other.
# Options: auto | opensky | adsblol | off
POSITIONS_PROVIDER=auto
# Optional free OpenSky API client (https://opensky-network.org → Account → API client).
# Anonymous access has ~400 credits/day (a world view costs 4); a registered client gets ~4000.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
